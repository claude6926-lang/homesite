# Copy this file to .env (or set these as real environment variables) before
# deploying. Never commit an actual .env file with real secrets to git.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_SECURE_SSL_REDIRECT=True

# Used to build canonical URLs, Open Graph tags and JSON-LD image URLs
SITE_NAME=บ้านเดี่ยว พฤกษ์ลดา ปิ่นเกล้า-สาย 5
SITE_URL=https://yourdomain.com
